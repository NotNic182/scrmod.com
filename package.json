{
  "name": "scr-hub",
  "version": "0.1.0",
  "description": "A browser companion for Sid's Competitive Rounds: presence, leaderboards, player stats, results, tournaments and card stats.",
  "type": "module",
  "private": true,
  "keywords": [
    "rounds",
    "competitive-rounds",
    "hono"
  ],
  "scripts": {
    "dev:server": "tsx watch src/server/node.ts",
    "build:server": "esbuild src/server/node.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server/node.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\"",
    "start": "node dist/server/node.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "capture": "node scripts/capture-fixtures.mjs",
    "contract": "node scripts/contract-check.mjs",
    "dev:web": "vite",
    "dev:fixtures": "cross-env SCR_FIXTURES=1 tsx watch src/server/node.ts",
    "build:web": "vite build",
    "build": "npm run build:web && npm run build:server",
    "preview": "cross-env SCR_FIXTURES=1 node dist/server/node.js"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@tanstack/react-query": "^5.103.2",
    "hono": "^4.13.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "uplot": "^1.6.32"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
